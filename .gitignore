# Captures and logs are the user's own session data. The ones committed under
# docs/logs/ are redacted copies; the raw material stays out.
/dso-capture/
*.pcap
*.pcapng
session-*.jsonl
calls-*.jsonl
stacks-*.jsonl
run-*.log
python-*.log

# Launch arguments hold a live session credential and the CDN root key.
cmd.txt
*cmd*.txt

# Scratch
__pycache__/
*.pyc
.pytest_cache/
/scratch/
/tmp/

# Saved characters are the operator's own data, and the file is a live database.
characters.sqlite
characters.sqlite-wal
characters.sqlite-shm

# The client's own database, loaded into memory at start. 69 MB of Bigpoint's data:
# it belongs in data/ on the operator's machine and not in this repository.
/data/*.db4
/data/*.sqlite

# Local defaults. For remote access, set DSO_HOST=0.0.0.0 and
# DSO_PUBLIC_HOST to an address reachable by game clients.
DSO_HOST=127.0.0.1
DSO_PUBLIC_HOST=127.0.0.1
DSO_REQUIRE_LOGIN=1
DSO_DEBUG_VENDOR=0
DSO_ACCOUNT_SERVICE=1
DSO_ADMIN_SERVICE=1
DSO_ADMIN_HOST=127.0.0.1

# Gameplay tuning. Unset keeps the defaults; the values shown are the
# xm1rth fork's tuning.
# DSO_MEMBERSHIP_XP_BUFF=1                 # Premium +50% / Deluxe +100% XP buff
# DSO_SPAWN_AREA_DENSITY_SCALE=0.35        # default 0.85
# DSO_SPAWN_AREA_MAX_TOTAL_MONSTERS=250    # default 162
# DSO_BOSS_BASIC_ATTACK_ROTATION=1         # bosses: special only every third choice
# DSO_PLAYER_LEVEL_CAP=100                 # default: the database's top level
# Client build. The default command map is R261_1024. For release261_203, set
# DSO_COMMAND_IDS=docs/command_ids_rel261_203.json. The existing skill/Hit
# marker setting is retained. For dro_client64-patch5 (or older DSOR clients):
# DSO_COMMAND_IDS=builtin
# DSO_SKILL_HIT_MARKER_BITS=0
# Another build needs its own table: see docs/COMMAND_IDS.md.
# DSO_COMMAND_IDS=path/to/command_ids_other.json
